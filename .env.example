# EyeDataHub credentials template
#
# Copy this file to .env, then uncomment and fill only the credentials you
# need for the datasets or publishing step you are using.
#
#   cp .env.example .env
#
# On Windows PowerShell:
#
#   Copy-Item .env.example .env
#
# The real .env file is ignored by git. Do not commit credentials.
# EyeDataHub automatically loads .env from the current directory or a parent
# directory without overriding environment variables that are already set.
# To use a different file, set EYEDATAHUB_ENV_FILE in your shell before
# running EyeDataHub.

# Kaggle datasets and competitions
# Create an API token at https://www.kaggle.com/settings/account
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key

# Hugging Face datasets, gated surgical-video resources, and hub publishing
# Create a token with the needed read/write scope at:
# https://huggingface.co/settings/tokens
# HF_TOKEN=hf_your_token_here
# HUGGING_FACE_HUB_TOKEN=hf_your_token_here

# Zenodo restricted or embargoed records
# Create a personal access token at:
# https://zenodo.org/account/settings/applications/
# ZENODO_TOKEN=your_zenodo_token

# Figshare private or restricted articles
# Create a personal token at:
# https://figshare.com/account/applications
# FIGSHARE_TOKEN=your_figshare_token

# Dryad records that exceed the public whole-archive limit
# Create an API application/token from your Dryad account.
# DRYAD_TOKEN=your_dryad_bearer_token

# Mendeley Data restricted records
# Create a personal token from your Mendeley Data account settings.
# MENDELEY_TOKEN=your_mendeley_token

# Dataverse restricted records
# Create an API token from your Dataverse account page.
# DATAVERSE_TOKEN=your_dataverse_token

# PhysioNet credentialed datasets
# Register, complete required training, and sign each dataset DUA first.
# PHYSIONET_USERNAME=your_physionet_username
# PHYSIONET_PASSWORD=your_physionet_password

# Synapse-hosted datasets
# Prefer `synapse login` when possible. Some synapseclient versions also
# accept environment credentials.
# SYNAPSE_AUTH_TOKEN=your_synapse_personal_access_token
# SYNAPSE_USERNAME=your_synapse_username
# SYNAPSE_PASSWORD=your_synapse_password

# Optional network proxy settings used by requests-based downloaders.
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
